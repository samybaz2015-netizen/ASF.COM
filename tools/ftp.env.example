# انسخ هذا الملف باسم ftp.env واملأ البيانات من لوحة تحكم SmarterASP.NET
# (القائمة: Websites > FTP Manager)
# ملف ftp.env مستثنى من Git ولن يُرفع إلى أي مكان.

FTP_HOST=asf-consulting.com
FTP_USER=asfconsult-002
FTP_PASS=
FTP_PORT=21
FTP_PASSIVE=1

# مجلد البداية. اتركه / لعرض كل المواقع، أو حدّد موقعاً بعينه:
#   /site1  = api       (الواجهة الخلفية لعصف)
#   /site2  = frontend  (واجهة عصف - asf-consulting.com)
#   /site3  = ataa      (برنامج عطاء - ممنوع لمسه من هذا المشروع)
FTP_REMOTE_DIR=/

# ضع 1 إذا كان الخادم يفرض اتصالاً مشفراً (FTPS)
FTP_SSL=0
